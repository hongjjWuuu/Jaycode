APP_NAME=Jaycode
APP_ENV=dev
JAYCODE_TASK_MAX_RUNTIME_SECONDS=900
MAX_SCAN_FILES=800
MAX_FILE_PREVIEW_CHARS=4000

# API authentication and RBAC. Keep disabled only for explicit local development.
JAYCODE_AUTH_ENABLED=false
JAYCODE_API_KEYS=

# Marketplace supply-chain controls.
JAYCODE_MARKETPLACE_REMOTE_ENABLED=false
JAYCODE_MARKETPLACE_ALLOWED_HOSTS=
JAYCODE_MARKETPLACE_REQUIRE_SIGNATURE=true
JAYCODE_MARKETPLACE_MAX_DOWNLOAD_BYTES=26214400
JAYCODE_MARKETPLACE_MAX_EXTRACTED_BYTES=104857600
JAYCODE_MARKETPLACE_MAX_FILES=1000
JAYCODE_EXTERNAL_SKILL_REQUIRE_DOCKER=true

# Optional LLM hot-plug config. Edit .env and the next LLM call will use it.
OPENAI_API_KEY=
# DeepSeek OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.deepseek.com
JAYCODE_AGENT_LLM=deepseek-v4-flash

# Optional per-Agent model overrides. These are hot-read on each LLM call.
# JAYCODE_AGENT_LLM_PLANNER=deepseek-v4-flash
# JAYCODE_AGENT_LLM_REPORTER=deepseek-v4-flash
# JAYCODE_AGENT_LLM_SUPERVISOR=deepseek-v4-flash
# JAYCODE_AGENT_LLM_PROJECT_ANALYZER=deepseek-v4-flash
# JAYCODE_AGENT_LLM_CODE_REVIEWER=deepseek-v4-flash
# JAYCODE_AGENT_LLM_FILE_REVIEWER=deepseek-v4-flash
# JAYCODE_AGENT_LLM_TASK_QA=deepseek-v4-flash
# JAYCODE_AGENT_LLM_LEARNING_COACH=deepseek-v4-flash
# JAYCODE_AGENT_LLM_MEMORY_EXTRACTOR=deepseek-v4-flash
# JAYCODE_AGENT_LLM_AGENT_MODELS=planner:deepseek-v4-flash,reporter:deepseek-v4-flash,supervisor:deepseek-v4-flash

# Optional prompt version overrides. These are hot-read on each LLM call.
# JAYCODE_PROMPT_PLANNER=planner.v2
# JAYCODE_PROMPT_REPORTER=reporter.v2
# JAYCODE_PROMPT_SUPERVISOR=supervisor.v2
# JAYCODE_PROMPT_PROJECT_ANALYZER_ARCHITECTURE=project_analyzer.architecture.v2
# JAYCODE_PROMPT_CODE_REVIEWER_SUGGESTIONS=code_reviewer.suggestions.v2
# JAYCODE_PROMPT_FILE_REVIEWER_SEMANTIC=file_reviewer.semantic.v2
# JAYCODE_PROMPT_TASK_QA=task_qa.v2
# JAYCODE_PROMPT_LEARNING_COACH_REPLY=learning_coach.reply.v2
# JAYCODE_PROMPT_LEARNING_COACH_QUESTIONS=learning_coach.questions.v2
# JAYCODE_PROMPT_MEMORY_EXTRACTOR=memory_extractor.v1

# Long-term memory extraction: llm uses the governed LLM extractor when a key is configured;
# otherwise the application falls back to explicit-preference rules. Set to rule to disable LLM extraction.
# Use rule for the most reliable local startup path.
JAYCODE_MEMORY_EXTRACTOR=rule

# Optional model price estimates, USD per 1M tokens. Used only by the dashboard.
# JAYCODE_LLM_PRICE_GPT_4O_MINI_INPUT_PER_1M=
# JAYCODE_LLM_PRICE_GPT_4O_MINI_OUTPUT_PER_1M=

# Formal runtime: PostgreSQL `jayagent_studio` is the authoritative store.
# Supply the two matching PostgreSQL URLs only in your private .env. SQLite is
# retained solely for compatibility and migration history, not normal service writes.
JAYCODE_RAG_STORE=pgvector
JAYCODE_RAG_RERANKER=off
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/jayagent_studio
PGVECTOR_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/jayagent_studio
JAYCODE_PERSISTENCE_STORE=postgres
# Choose exactly one worker mode: enable this for API-managed workers, or keep
# it false and start an independent app.harness.worker process.
JAYCODE_WORKER_SUPERVISOR_ENABLED=false
JAYCODE_WORKER_SUPERVISOR_MAX_RESTARTS=5
JAYCODE_WORKER_SUPERVISOR_STARTUP_TIMEOUT_SECONDS=5
JAYCODE_WORKER_COUNT=1
JAYCODE_OPERATIONS_STALE_QUEUE_SECONDS=300
JAYCODE_OPERATIONS_FAILED_TASK_LIMIT=20
JAYCODE_LLM_FALLBACK_RATE_THRESHOLD=0.2
JAYCODE_LLM_SCHEMA_FAILURE_RATE_THRESHOLD=0.05
JAYCODE_LLM_P95_LATENCY_THRESHOLD_MS=30000
JAYCODE_LLM_ALERT_MIN_SAMPLES=20
JAYCODE_EMBEDDING_MODEL=text-embedding-3-small
JAYCODE_EMBEDDING_DIM=1536

# MCP provider switch.
# local = built-in deterministic filesystem/git adapter.
# mcp = real stdio MCP client using server configs saved through /api/v1/mcp/servers.
JAYCODE_MCP_PROVIDER=local
JAYCODE_MCP_ALLOWED_COMMANDS=
JAYCODE_MCP_MAX_RUNTIME_SECONDS=15
JAYCODE_MCP_MAX_OUTPUT_BYTES=1048576

# Code Skill sandbox.
# subprocess = local isolated Python child process.
# docker = stronger sandbox for execution_type=python skills.
# Docker mode uses: --network none, --read-only, --cap-drop ALL,
# no-new-privileges, memory/CPU/PID limits, read-only skill mount.
JAYCODE_SKILL_SANDBOX=subprocess
JAYCODE_SKILL_SANDBOX_IMAGE=python:3.13-slim
JAYCODE_SKILL_SANDBOX_MEMORY=256m
JAYCODE_SKILL_SANDBOX_CPUS=0.5
JAYCODE_SKILL_SANDBOX_PIDS_LIMIT=64
# Keep false in production so Docker failures do not silently downgrade.
JAYCODE_SKILL_SANDBOX_FALLBACK=false
